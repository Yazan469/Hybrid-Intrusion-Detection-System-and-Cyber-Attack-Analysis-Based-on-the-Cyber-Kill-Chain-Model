drop icmp any any -> any any (msg:"Ping Blocked by Snort IPS"; sid:1000005; rev:1;)
alert icmp any any -> any any (msg:"ICMP test"; sid:10000001; rev:1;)
alert tcp any any -> 192.168.193.129 22 (flags:S; msg:"TCP SYN Scan Detected"; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET any (flags:S; msg:"Potential TCP SYN Scan (Nmap)"; threshold:type threshold, track by_src, count 20, seconds 5; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"Custom Alert - Possible Nmap Scan Detected"; flags:S; threshold:type both, track by_src, count 10, seconds 5; sid:10000004; rev:1;)
